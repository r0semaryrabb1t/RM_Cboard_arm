# .gitignore for STM32 / ARM Projects

# Build artifacts
build/
build-*/
*.elf
*.bin
*.hex
*.map
*.lst
*.o
*.d
*.su

# IDE files
.vscode/
.idea/
*.ioc.bak
*.project
*.cproject
*.launch
*.settings

# Debug files
*.swp
*.swo
*~

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# STM32CubeMX
*.mxproject.bak
.mxproject

# Logs
*.log

# OS files
.DS_Store
Thumbs.db
